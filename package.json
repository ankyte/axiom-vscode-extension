{
  "name": "axiom",
  "displayName": "AXIOM",
  "description": "AXIOM eXtracts Intent from Operational Memory",
  "version": "1.0.0",
  "main": "./out/extension.js",
  "engines": {
    "vscode": "^1.107.0"
  },
  "activationEvents": [
    "onCommand:axiom.initialize",
    "onCommand:axiom.context",
    "onCommand:axiom.caveman",
    "onCommand:axiom.summary",
    "onCommand:axiom.risks",
    "onCommand:axiom.why",
    "onCommand:axiom.copyContext",
    "onCommand:axiom.copyCombinedContext",
    "onCommand:axiom.exportContext",
    "onCommand:axiom.importAIContext",
    "onCommand:axiom.refreshImportedContext",
    "onCommand:axiom.compressAIConversations",
    "onView:axiom.sidebar"
  ],
  "scripts": {
    "compile": "tsc -p ./"
  },
  "contributes": {
    "commands": [
      { "command": "axiom.initialize", "title": "AXIOM: Initialize Repository" },
      { "command": "axiom.context", "title": "/axiom-context" },
      { "command": "axiom.caveman", "title": "/axiom-caveman" },
      { "command": "axiom.summary", "title": "/axiom-summary" },
      { "command": "axiom.risks", "title": "/axiom-risks" },
      { "command": "axiom.why", "title": "/axiom-why" },
      { "command": "axiom.copyContext", "title": "AXIOM: Copy AXIOM Context" },
      { "command": "axiom.copyCombinedContext", "title": "AXIOM: Copy Combined Operational Context" },
      { "command": "axiom.exportContext", "title": "AXIOM: Export Context" },
      { "command": "axiom.importAIContext", "title": "AXIOM: Import AI Context" },
      { "command": "axiom.refreshImportedContext", "title": "AXIOM: Refresh Imported Context" },
      { "command": "axiom.compressAIConversations", "title": "AXIOM: Compress AI Conversations" }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "axiom",
          "title": "AXIOM",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "axiom": [
        {
          "id": "axiom.sidebar",
          "name": "Operational Memory",
          "type": "webview"
        }
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.107.0",
    "@vscode/vsce": "^3.9.1",
    "typescript": "^6.0.3"
  }
}
