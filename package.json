{
    "name": "axiom",
    "displayName": "Axiom",
    "description": "Axiom eXtracts Intent from organization memory",
    "version": "1.0.0",
    "activationEvents": [
        "onLanguage:python",
        "onView:exceptionWrapper.sidebar"
    ],
    "scripts": {
        "compile": "tsc -p ./"
    },
    "main": "./out/extension.js",
    "engines": {
        "vscode": "^1.107.0"
    },
    "contributes": {
        "commands": [
            {
                "command": "wrapSelection.tryExcept",
                "title": "Wrap in try/except"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "exceptionWrapper",
                    "title": "Axiom",
                    "icon": "media/icon.svg"
                }
            ]
        },
        "views": {
            "exceptionWrapper": [
                {
                    "id": "exceptionWrapper.sidebar",
                    "name": "Axiom",
                    "type": "webview"
                }
            ]
        },
        "menus": {
            "editor/context": [
                {
                    "command": "wrapSelection.tryExcept",
                    "when": "editorLangId == python && editorHasSelection",
                    "group": "navigation@50"
                }
            ]
        },
        "keybindings": [
            {
                "command": "wrapSelection.tryExcept",
                "key": "ctrl+alt+t",
                "mac": "cmd+alt+t",
                "when": "editorTextFocus && editorLangId == python && editorHasSelection"
            }
        ]
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "@types/vscode": "^1.107.0",
        "@vscode/vsce": "^3.9.1",
        "typescript": "^6.0.3"
    }
}
